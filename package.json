{
  "name": "playwright-interview-grade-2026",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI and API test framework for automationexercise.com",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  }
}
